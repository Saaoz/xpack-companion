{
  "schemaVersion": 1,
  "id": "xpack",
  "version": "${version}",
  "name": "XPack Companion",
  "description": "Suit tes succès de modpacks sur XPack. Mod client optionnel : aucun modpack n'a besoin de le déclarer.",
  "authors": ["XPack"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["net.xpack.companion.fabric.XPackFabric"]
  },
  "mixins": ["xpack.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21"
  }
}
